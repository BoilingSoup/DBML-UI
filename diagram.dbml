// dbml-ui feature showcase — open this file to see every diagram
// embellishment in one place. (Comments like this one also demonstrate
// that format-on-save skips commented sources instead of dropping them.)
Project dbml_ui_showcase {
  database_type: 'PostgreSQL'
  note: 'A tour of every visual embellishment'
}

// ── Badges: Not Null / Unique pills, key + link icons, note paper icon ──
Table users as U [headercolor: #2d5f8a] {
  id integer [pk, increment, not null, unique, note: 'The user identifier — hover the paper icon to read me']
  username varchar(80) [not null, unique, note: 'Login handle, unique across the instance']
  email varchar(255) [not null, unique]
  display_name varchar(120) [null]
  role user_role [not null, default: 'member']
  created_at timestamp [not null, default: `now()`]
  referrer_id integer [null, note: 'Self-reference: who invited this user']
}

Table posts as P [headercolor: #7a4f9e] {
  id integer [pk, increment, not null]
  author_id integer [not null, note: 'FK side of the link icon']
  title varchar(200) [not null]
  slug varchar(220) [not null, unique]
  body text [null, note: 'Markdown body — can be very long, notes are capped at 60 chars in the tooltip']
  status post_status [not null, default: 'draft']
  published_at timestamp [null]
  records (id, author_id, title, status) {
    1, 1, 'Hello world', 'published'
    2, 1, 'Second post', 'draft'
    3, 2, 'Guest appearance', 'archived'
  }
}

Table comments {
  id integer [pk, increment, not null]
  post_id integer [not null, note: 'Which post this comment belongs to']
  author_id integer [not null]
  body text [not null]
}

// ── Enum: its own box type, values with per-value notes ──
Enum user_role {
  member [note: 'Default role after signup']
  moderator
  admin [note: 'Full access — hover to read']
}

Enum post_status {
  draft
  published
  archived
}

// ── Indexes block: unique / pk / named / typed indexes ──
Table sessions {
  id integer [pk, increment]
  user_id integer [not null]
  token varchar(128) [not null, unique]
  expires_at timestamp [not null]
  indexes {
    (user_id) [name: 'idx_sessions_user']
    (user_id, expires_at) [name: 'idx_sessions_user_expiry', type: hash]
  }
}

// ── TableGroup: a labeled colored region around its tables (hover the
// label for the note) ──
TableGroup "Content System" [color: #1E69FD] {
  posts
  comments
  Note: '''
  This group manages the user content functionality.
  - posts: the articles themselves
  - comments: reader responses
  '''
}

// ── Custom properties: any `key: "value"` pair on a table or column ──
// (hover the audit_log header or its rows in the diagram to see the
// "Custom Properties" hover cards, like dbdiagram's)
Table audit_log [owner: "data-team", sla_hours: "24", pii: "true"] {
  id integer [pk, increment]
  event varchar [classification: "confidential"]
  masked_id integer [masking: "partial"]
}

// ── Refs: every cardinality — crow's foot (many) and tick (one) ends ──
Ref: posts.author_id > users.id [color: #f1c40f]

Ref: comments.post_id > posts.id

Ref: comments.author_id > users.id

Ref: users.referrer_id > users.id

Ref: sessions.user_id > users.id

// inline ref syntax (also produces a link icon + edge)
Table likes {
  id integer [pk, increment]
  user_id integer [not null, ref: > users.id]
  post_id integer [not null, ref: > posts.id]
}

// ── Sticky notes: `Note name { '''text''' }` renders a yellow sticky on the canvas
Note todo {
  '''
  TODO 1: David to add rating to the products table
  TODO 2: Tea to add price to the products table
  '''
}
