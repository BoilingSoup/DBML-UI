Table "quoted name" {
  x text
  indexes {
    (x) [unique]
  }
  Note: 'table note'
}
Table a {
  "odd col" decimal(10, 2) [note: 'n', not null, ref: <> nope.odd col]
  name e_status [increment, note: 'n']
  user_id text [note: 'n', not null]
  indexes {
    user_id
  }
}
Table t1 {
  x "character varying" [pk, ref: > quoted name.x]
  user_id varchar(255) [color: #1E69FD, ref: ?<> nope.x]
  code int[]
}
Ref r0: t1.odd col < t1.x
Ref: a.user_id ?<> a.code
Enum e_status {
  open
  closed [note: 'done']
}
TableGroup g { quoted name, a, t1 }
