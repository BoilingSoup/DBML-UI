Table ñT {
  "odd col" e_status [note: 'n', check: `x > 0`]
  Note: 'table note'
}
Table "quoted name" {
  x varchar(255) [color: #1E69FD]
  user_id decimal(10, 2) [not null]
  indexes {
    (user_id) [unique, name: 'ix']
    x [unique, name: 'ix']
  }
}
Table my_table {
  "odd col" text
  user_id e_status [color: #1E69FD, increment]
  Note: 'table note'
}
Ref r0: my_table.odd col >? quoted name.odd col
Ref: my_table.id >? my_table.odd col
Enum e_status {
  open
  closed [note: 'done']
}
