Table _x {
  user_id bool [pk]
}
Table _x {
  id integer [color: #1E69FD]
}
Table posts {
  user_id varchar(255) unique
  code bool [note: 'n', default: 1]
  user_id "character varying"
}
Table _x {
  user_id integer
  user_id "character varying" [null]
  x timestamp [note: 'n', default: 'x', ref: ?- _x.user_id]
  indexes {
    user_id [pk]
    (user_id) [unique]
  }
  Note: 'table note'
}
TableGroup g { _x, _x, posts, _x }
