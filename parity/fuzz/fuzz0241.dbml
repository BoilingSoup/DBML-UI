Table _x {
  code integer [null]
  x bool pk
  indexes {
    x
  }
}
Table posts {
  user_id int[] [note: 'n']
  x decimal(10, 2) [null, default: 'x']
  user_id int[] [default: 'x', default: `now()`]
  records (user_id) {
    1
  }
}
Table posts {
  name decimal(10, 2) [pk, color: #1E69FD, ref: ?> posts.name]
  name decimal(10, 2) [unique]
}
Table B {
  name decimal(10, 2) [default: `now()`, ref: <? posts.name]
}
Ref: posts.code -? posts.code
Ref: posts.user_id <>? B.name
TableGroup g { _x, posts, posts, B }
