Table users {
  id e_status
  name varchar(255) [default: 'x', not null, ref: >? nope.id]
  "odd col" integer unique
  indexes {
    (id) [unique, name: 'ix']
    name [unique]
  }
}
Table B {
  name varchar(255)
}
Table users {
  x "character varying" [default: `now()`]
  user_id int[]
  "odd col" bool [null]
  indexes {
    (user_id) [unique]
    (user_id)
  }
}
Table orders {
  id e_status [color: #1E69FD, not null, ref: >? B.id]
  x int[] [check: `x > 0`]
  x e_status [default: `now()`]
  code timestamp [null, default: `now()`]
  indexes {
    (x) [unique]
  }
  Note: 'table note'
}
Enum e_status {
  open
  closed [note: 'done']
}
Note sticky {
  '''
  text
  '''
}
