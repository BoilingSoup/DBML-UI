  name e_status [unique, default: 'x']
  indexes {
    (name) [pk]
    (name) [unique, name: 'ix']
  }
  Note: 'table note'
  records (name) {
    'a'
  }
}
Table t1 {
  user_id integer
  id bool [default: `now()`]
}
Table ñT {
  "odd col" varchar(255) [default: 'x', note: 'n']
  id e_status [default: `now()`, unique]
  id "character varying"
