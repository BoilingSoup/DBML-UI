Table a {
  user_id e_status [default: `now()`]
  user_id e_status [check: `x > 0`, ref: <? nope.user_id]
  code decimal(10, 2) [pk, check: `x > 0`, ref: - a.code]
  Note: 'table note'
}
Table orders {
  x "character varying"
}
Table t1 {
  user_id e_status
  "odd col" decimal(10, 2) [check: `x > 0`, ref: ?< a.odd col]
  id integer [color: #1E69FD]
  x int[]
  records (user_id) {
    true
  }
}
TableGroup g { a, orders, t1 }
