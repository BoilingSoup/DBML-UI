Table users {
  name int[] [color: #1E69FD]
  name "character varying" [check: `x > 0`]
  indexes {
    (name) [unique, name: 'ix']
    (name) [pk]
  }
}
Table t1 {
  code int[] [null, note: 'n', ref: <> users.code]
  id varchar(255) [not null, pk, ref: < nope.code]
  indexes {
    code
    code [unique, name: 'ix']
  }
}
Ref: users.code <> users.id
