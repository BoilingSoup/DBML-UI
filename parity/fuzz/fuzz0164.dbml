Table t1 {
  "odd col" varchar(255) [default: `now()`, color: #1E69FD, ref: >? t1.odd col]
  id "character varying" unique
  name timestamp [null, default: `now()`]
  Note: 'table note'
}
Table users {
  x decimal(10, 2) [null, default: 1]
  code "character varying" [default: 'x']
  name text
  Note: 'table note'
}
Table orders {
  name timestamp
  code decimal(10, 2) unique
  user_id text
  records (name) {
    2.5
    2.5
    `x`
  }
}
Ref: orders.name ?<> t1.id
Ref r1: users.user_id <> users.odd col
Enum e_status {
  open
  closed [note: 'done']
}
