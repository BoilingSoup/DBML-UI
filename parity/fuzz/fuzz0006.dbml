Table ñT {
  user_id "character varying" [check: `x > 0`]
  "odd col" varchar(255)
}
Table orders {
  id "character varying" [note: 'n', pk]
  Note: 'table note'
}
Table posts {
  name bool [default: 1]
  indexes {
    name [unique, name: 'ix']
  }
}
Table posts {
  "odd col" bool
  indexes {
