Table _x {
  id int[] [default: 'x']
  id decimal(10, 2) [unique]
  name decimal(10, 2) [default: 1, default: `now()`, ref: <>? nope.name]
  x varchar(255) [increment, color: #1E69FD, ref: <> _x.id]
  records (id) {
    null
  }
}
Table users {
  "odd col" decimal(10, 2) [default: 1, unique]
  "odd col" "character varying" [default: 'x', increment]
  x text [default: `now()`, check: `x > 0`]
  indexes {
    (odd col) [unique]
  }
}
Table posts {
  x varchar(255)
}
Table t1 {
  user_id integer [unique, note: 'n']
  user_id "character varying" [unique, note: 'n', ref: <? _x.user_id]
  indexes {
    user_id [unique]
  }
}
Ref r0: t1.name ?> t1.id
Enum e_status {
  open
  closed [note: 'done']
}
