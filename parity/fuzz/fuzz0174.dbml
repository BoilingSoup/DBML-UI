Table "quoted name" {
  user_id timestamp [null, check: `x > 0`]
}
Table _x {
  "odd col" timestamp [null, default: 'x', ref: <> nope.odd col]
  x "character varying"
  name timestamp [increment, null]
  Note: 'table note'
}
Table orders {
  id text [check: `x > 0`, color: #1E69FD, ref: - nope.id]
}
Ref: orders.id <> "missing".code
Ref: orders.odd col -? "missing".x
TableGroup g { quoted name, _x, orders }
