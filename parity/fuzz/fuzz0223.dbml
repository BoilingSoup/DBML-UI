Table t1 {
  id varchar(255) [default: 1, unique]
  code decimal(10, 2) unique
  "odd col" decimal(10, 2) [default: 1]
  indexes {
    (odd col) [pk]
    (odd col) [pk]
  }
}
Table my_table {
  name "character varying" [increment, not null]
  code timestamp [note: 'n', default: 1, ref: ?< t1.name]
  x integer [unique]
  "odd col" decimal(10, 2) [pk, default: 'x']
  indexes {
    (code) [unique, name: 'ix']
  }
  Note: 'table note'
  records (name) {
    true
    `x`
    null
  }
}
Table _x {
  x varchar(255) foo
  "odd col" timestamp
  name "character varying" [color: #1E69FD, ref: <> nope.name]
  Note: 'table note'
}
Table t1 {
  "odd col" decimal(10, 2) [unique]
  id decimal(10, 2) [note: 'n', color: #1E69FD]
  id integer [not null]
  indexes {
    odd col [unique]
    id
  }
  Note: 'table note'
}
Ref: _x.odd col < "missing".user_id
TableGroup g { t1, my_table, _x, t1 }
