Table a {
  code "character varying"
  x text [pk, ref: > a.code]
  Note: 'table note'
}
Table orders {
  code decimal(10, 2) [default: `now()`]
  x "character varying" [null]
}
Table t1 {
  name integer [color: #1E69FD, increment, ref: -? orders.name]
  id text [not null]
  x decimal(10, 2) [default: 1, unique, ref: <? t1.name]
  indexes {
    (x) [unique]
    id [unique, name: 'ix']
  }
  Note: 'table note'
}
Table a {
  code e_status [default: `now()`, increment]
  code int[] [increment, unique]
}
Ref r0: t1.id >? a.x
