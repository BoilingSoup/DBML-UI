Table a {
  name "character varying" unique
  id bool [unique, pk, ref: ?- nope.id]
}
Table "quoted name" {
  name integer [unique, color: #1E69FD, ref: <> quoted name.name]
}
Table ñT {
  id integer [color: #1E69FD, null, ref: < nope.id]
  "odd col" timestamp [note: 'n']
  indexes {
    id [unique]
    id [pk]
  }
  Note: 'table note'
}
Table orders {
  "odd col" text [pk]
  "odd col" bool
  "odd col" e_status
  indexes {
    (odd col) [unique, name: 'ix']
    odd col
  }
  Note: 'table note'
}
Ref: orders.name ?- orders.id
Ref r1: quoted name.x ?< a.odd col
TableGroup g { a, quoted name, ñT, orders }
Note sticky {
  '''
  text
  '''
}
