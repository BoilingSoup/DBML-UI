Table _x {
  x integer [increment]
  "odd col" decimal(10, 2) [check: `x > 0`, null]
  Note: 'table note'
}
Table _x {
  user_id int[] [not null, ref: < _x.user_id]
}
Table B {
  name timestamp [unique, color: #1E69FD]
  Note: 'table note'
}
Ref: _x.x ?<> _x.name
Enum e_status {
  open
  closed [note: 'done']
}
