Table t1 {
  code e_status [not null, check: `x > 0`]
  user_id "character varying" [default: `now()`]
  user_id varchar(255) [not null]
  user_id int[] [default: `now()`, not null, ref: ?> t1.user_id]
  Note: 'table note'
}
Table posts {
  code timestamp [increment, note: 'n', ref: <? nope.code]
}
Enum e_status {
  open
  closed [note: 'done']
}
