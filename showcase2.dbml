// dbml-ui stress showcase — every popup shape (overflowing and not),
// every note/custom-property combination, and the full feature surface:
// aliases, header colors, all cardinalities, composite + inline refs,
// indexes, records, groups, sticky notes, and enums.

Project dbml_ui_stress {
  database_type: 'PostgreSQL'
  note: 'Stress tour: popups that overflow, popups that do not, and everything in between'
}

// ── Table popup that OVERFLOWS: a long note plus six custom properties ──
// (hover the header: the card body wheel-scrolls)
Table orders [headercolor: #8a4f2d, owner: "fulfillment-team", sla_hours: "48", escalation: "on-call@shop.example", region: "eu-central", pii: "customer emails only", retention: "7 years"] {
  id integer [pk, increment, not null]
  customer_id integer [not null]
  placed_at timestamp [not null, default: `now()`]
  total_cents integer [not null, default: '0']
  fulfillment_note text [null, note: 'Long single-column note: the courier pickups happen twice a day, once before the morning batch and once after the evening reconciliation, so fulfillment notes written after 6pm are not read until the following business day — plan accordingly.']
  warehouse_id integer [null, note: 'Fulfilling warehouse once the order ships']
  status order_status [not null, default: 'placed', note: 'Drives the pipeline; the enum pill on the right lists every value', priority: "high", sla: "4h", escalation: "on-call", audit: "full"]

  records (id, customer_id, total_cents, status) {
    1, 1, 12999, 'placed'
    2, 2, 4500, 'shipped'
    3, 1, 78000, 'delivered'
  }

  note: '''
  Orders is the transactional heart of the schema. This note is deliberately long so the table popup overflows its max height and the body becomes wheel-scrollable: the morning batch imports from the storefront, the evening job reconciles against the payment provider, and the warehouse team reads fulfillment notes twice a day. If you are reading this text inside the popup, scrolling works.
  '''
}

// ── Table popup that does NOT overflow: a short note and two short props ──
Table customers as C [headercolor: #2d7a4f, owner: "growth-team"] {
  id integer [pk, increment, not null]
  email varchar(255) [not null, unique]
  tier customer_tier [not null, default: 'free', note: 'Pricing tier', marketing: "opt-in"]
  joined_at timestamp [not null, default: `now()`]

  note: 'Short note: no scroll needed.'
}

// ── Column popups: both note AND custom properties, on one row ──
Table payments [headercolor: #4f2d8a, owner: "billing-team"] {
  id integer [pk, increment, not null]
  order_id integer [not null, ref: > orders.id]
  amount_cents integer [not null]
  method payment_method [not null]
  processor_ref varchar(120) [null, note: 'Gateway reference — populated after the first successful capture attempt, retried nightly', gateway: "stripe", region: "eu", retry: "3x", signed: "true"]
  captured_at timestamp [null, prop: "value"]

  indexes {
    (order_id) [name: 'idx_payments_order']
    (method, captured_at) [name: 'idx_payments_method_time', type: hash]
  }

}

// ── Table popup: custom properties only, no note (short, no overflow) ──
Table warehouses [owner: "logistics", wms: "v2"] {
  id integer [pk, increment, not null]
  batch_no integer [not null]
  city varchar(80) [not null]
  capacity integer [not null, default: '500']
}

// ── Table with a note only (no custom properties, short) ──
Table shipments {
  id integer [pk, increment, not null]
  order_id integer [not null]
  warehouse_id integer [not null]
  batch_no integer [not null]
  shipped_at timestamp [null, note: 'Set by the scanner gun']

  note: 'Shipments leave through one of the warehouses.'
}

// ── Composite (multi-column) ref: shipments batch -> warehouse key ──
Ref: (shipments.warehouse_id, shipments.batch_no) > (warehouses.id, warehouses.batch_no)

// ── All four cardinalities, including one-to-one and many-to-many ──
Ref: orders.customer_id > customers.id [color: #2d7a4f]
Ref: payments.order_id > orders.id
Ref: orders.warehouse_id - warehouses.id
Ref: shipments.warehouse_id <> orders.warehouse_id [color: #8a4f2d]

// ── One-to-many pointing left, exercise the < tick side ──
Ref: customers.id < orders.id

// ── Enum popup with per-value notes (hover `status` / `tier` rows) ──
Enum order_status {
  placed [note: 'Cart checked out, awaiting payment']
  paid
  shipped [note: 'Handed to the courier']
  delivered
  cancelled [note: 'Refund issued automatically']
}

Enum customer_tier {
  free
  silver
  gold [note: 'Annual plan']
}

Enum payment_method {
  card
  paypal
  bank_transfer [note: 'Manual reconciliation, 2-3 days']
  crypto
}

// ── Big enum: the tooltip pill caps its value list (12 visible) ──
Enum region_code {
  eu_central
  eu_west
  eu_north
  eu_south
  us_east_1
  us_east_2
  us_west_1
  us_west_2
  ap_southeast_1
  ap_southeast_2
  ap_northeast_1
  ap_northeast_2
  sa_east_1
  me_central_1
  af_south_1
}

// ── TableGroup, plain (no color): hover the label for the note ──
TableGroup "Billing" {
  payments
  Note: '''
  Payments and their gateway plumbing.
  '''
}

// ── Second group: colored, two members ──
TableGroup "Fulfillment" [color: #8a4f2d] {
  warehouses
  shipments
}

// ── Sticky notes: one short, one long ──
Note idea {
  '''
  Split the payments table by region in Q3.
  '''
}

Note backlog {
  '''
  - backfill processor_ref for the legacy rows
  - add the retry counter column
  - shadow-write to the new schema before the cutover
  - ask David about the batch numbering scheme
  '''
}
