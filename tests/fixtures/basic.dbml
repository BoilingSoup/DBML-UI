Project blog {
  database_type: 'PostgreSQL'
  Note: 'A small blog schema'
}

Table users as U [note: 'Registered accounts', headercolor: #3498DB] {
  id integer [pk, increment]
  username varchar(80) [not null, unique]
  email varchar(255) [not null]
  role varchar [default: 'member']
  created_at timestamp [default: `now()`]

  indexes {
    (username, email) [unique, name: 'idx_users_contact']
  }
}

Table posts [headercolor: #2ECC71] {
  id integer [pk]
  user_id integer [not null, ref: > U.id]
  status post_status [not null, default: 'draft']
  title varchar(200) [not null]
  body text
  published_at timestamp [note: 'Null until published']
}

Table comments {
  id integer [pk]
  post_id integer [not null, ref: > posts.id]
  author_id integer [not null]
  body text [not null]
}

Enum post_status {
  draft
  published [note: 'Live for everyone']
  archived
}

TableGroup content {
  posts
  comments
}

Ref: comments.author_id > users.id
Ref post_post: posts.id - posts.id
