Table users {
  id integer [pk, increment]
  country_id int [not null]
}

Table countries {
  id integer [pk]
  editor_id int
}

Table posts {
  id integer [pk, increment]
  author_id integer [not null, ref: > users.id]
  country_id int
  editor_id int
}

Ref: posts.country_id > countries.id
Ref: posts.(country_id, editor_id) > countries.(id, editor_id) [delete: cascade, update: set null]
